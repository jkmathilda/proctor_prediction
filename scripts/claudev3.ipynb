   "source": [
    "---\n",
    "## Section 14: Ensemble — PINN + XGBoost\n",
    "If PINN is competitive, blending it with XGBoost may reduce variance."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-33",
   "metadata": {},
   "outputs": [],
   "source": [
    "def cv_ensemble(X_raw, y_mdd, y_owc, rho_s,\n",
    "                lambda_zav, lambda_av,\n",
    "                w_pinn=0.5, n_splits=5, **train_kw):\n",
    "    \"\"\"Weighted ensemble of PINN and XGBoost, evaluated by 5-fold CV.\"\"\"\n",
    "    kf = KFold(n_splits=n_splits, shuffle=True, random_state=42)\n",
    "    scores = []\n",
    "    for tr, val in kf.split(X_raw):\n",
    "        sc   = StandardScaler()\n",
    "        Xtr  = sc.fit_transform(X_raw[tr]).astype(np.float32)\n",
    "        Xva  = sc.transform(X_raw[val]).astype(np.float32)\n",
    "\n",
    "        pinn_m, _ = train_pinn(Xtr, y_mdd[tr], y_owc[tr], rho_s[tr],\n",
    "                                lambda_zav=lambda_zav, lambda_av=lambda_av, **train_kw)\n",
    "        mp_p, op_p = predict_pinn(pinn_m, Xva)\n",
    "\n",
    "        mx = xgb.XGBRegressor(**xgb_params).fit(X_raw[tr], y_mdd[tr])\n",
    "        ox = xgb.XGBRegressor(**xgb_params).fit(X_raw[tr], y_owc[tr])\n",
    "        mp_x = mx.predict(X_raw[val])\n",
    "        op_x = ox.predict(X_raw[val])\n",
    "\n",
    "        mp_ens = w_pinn * mp_p + (1 - w_pinn) * mp_x\n",
    "        op_ens = w_pinn * op_p + (1 - w_pinn) * op_x\n",
    "        scores.append(nmae_np(y_mdd[val], y_owc[val], mp_ens, op_ens))\n",
    "    return np.mean(scores), np.std(scores)\n",
    "\n",
    "print('Running PINN + XGBoost ensemble CV (w_pinn sweep)...')\n",
    "ens_results = []\n",
    "for wp in [0.2, 0.4, 0.5, 0.6, 0.8]:\n",
    "    m, s = cv_ensemble(X_train_raw, y_mdd, y_owc, rho_s_train,\n",
    "                        best_lz, best_la, w_pinn=wp, **TRAIN_KW)\n",
    "    ens_results.append({'w_pinn': wp, 'cv_mean': m, 'cv_std': s})\n",
    "    print(f'  w_pinn={wp:.1f}:  {m:.4f} ± {s:.4f}')\n",
    "\n",
    "df_ens = pd.DataFrame(ens_results)\n",
    "best_ens = df_ens.loc[df_ens['cv_mean'].idxmin()]\n",
    "print(f'\\nBest ensemble: w_pinn={best_ens[\"w_pinn\"]}  NMAE={best_ens[\"cv_mean\"]:.4f}')\n",
    "print(f'Pure XGBoost:                           NMAE={xgb_mean:.4f}')"
   ]
